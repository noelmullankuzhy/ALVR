{
  "to_controller_type": "playstation_vr2_sense",
  "layouts": [
    {
      "from_controller_type": "oculus_touch", "priority": 100,
      "simulate_controller_type": true, "simulate_render_model": true, "simulate_HMD": true,
      "autoremappings": [
        { "from": "/user/hand/left/input/trigger", "to": "/user/hand/left/input/l2", "mirror": false },
        { "from": "/user/hand/right/input/trigger", "to": "/user/hand/right/input/r2", "mirror": false },
        { "from": "/user/hand/left/input/grip", "to": "/user/hand/left/input/l1", "mirror": false },
        { "from": "/user/hand/right/input/grip", "to": "/user/hand/right/input/r1", "mirror": false },
        { "from": "/user/hand/left/input/joystick", "to": "/user/hand/left/input/left_stick", "mirror": false },
        { "from": "/user/hand/right/input/joystick", "to": "/user/hand/right/input/right_stick", "mirror": false },
        { "from": "/user/hand/left/input/x", "to": "/user/hand/left/input/square", "mirror": false },
        { "from": "/user/hand/left/input/y", "to": "/user/hand/left/input/triangle", "mirror": false },
        { "from": "/user/hand/right/input/a", "to": "/user/hand/right/input/cross", "mirror": false },
        { "from": "/user/hand/right/input/b", "to": "/user/hand/right/input/circle", "mirror": false },
        { "from": "/user/hand/left/input/application_menu", "to": "/user/hand/right/input/options", "mirror": false }
      ],
      "remappings": [
        { "from": { "path": "/user/hand/left/input/application_menu", "mode": "button", "input": "click" }, "to": { "path": "/user/hand/right/input/options", "mode": "complex_button", "input": "single" }, "mirror": false },
        { "from": { "path": "/user/hand/left/pose/base" }, "to": { "path": "/user/hand/left/pose/raw" } },
        { "from": { "path": "/user/hand/left/pose/handgrip" }, "to": { "path": "/user/hand/left/pose/raw" } },
        { "from": { "path": "/user/hand/left/pose/tip" }, "to": { "path": "/user/hand/left/pose/raw" } },
        { "from": { "path": "/user/hand/left/pose/openxr_aim" }, "to": { "path": "/user/hand/left/pose/raw" } }
      ]
    },
    {
      "from_controller_type": "knuckles", "priority": 90,
      "simulate_controller_type": true, "simulate_render_model": true, "simulate_HMD": true,
      "autoremappings": [
        { "from": "/user/hand/left/input/trigger", "to": "/user/hand/left/input/l2", "mirror": false },
        { "from": "/user/hand/right/input/trigger", "to": "/user/hand/right/input/r2", "mirror": false },
        { "from": "/user/hand/left/input/grip", "to": "/user/hand/left/input/l1", "mirror": false },
        { "from": "/user/hand/right/input/grip", "to": "/user/hand/right/input/r1", "mirror": false },
        { "from": "/user/hand/left/input/thumbstick", "to": "/user/hand/left/input/left_stick", "mirror": false },
        { "from": "/user/hand/right/input/thumbstick", "to": "/user/hand/right/input/right_stick", "mirror": false },
        { "from": "/user/hand/left/input/a", "to": "/user/hand/left/input/square", "mirror": false },
        { "from": "/user/hand/left/input/b", "to": "/user/hand/left/input/triangle", "mirror": false },
        { "from": "/user/hand/right/input/a", "to": "/user/hand/right/input/cross", "mirror": false },
        { "from": "/user/hand/right/input/b", "to": "/user/hand/right/input/circle", "mirror": false },
        { "from": "/user/hand/left/input/trackpad", "to": "/user/hand/left/input/left_stick", "mirror": false },
        { "from": "/user/hand/right/input/trackpad", "to": "/user/hand/right/input/right_stick", "mirror": false }
      ],
      "remappings": [
        { "from": { "path": "/user/hand/left/pose/base" }, "to": { "path": "/user/hand/left/pose/raw" } },
        { "from": { "path": "/user/hand/left/pose/handgrip" }, "to": { "path": "/user/hand/left/pose/raw" } },
        { "from": { "path": "/user/hand/left/pose/tip" }, "to": { "path": "/user/hand/left/pose/raw" } },
        { "from": { "path": "/user/hand/left/pose/openxr_aim" }, "to": { "path": "/user/hand/left/pose/raw" } }
      ]
    }
  ]
}
