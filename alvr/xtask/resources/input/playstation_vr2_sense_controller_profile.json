{
  "jsonid": "input_profile",
  "controller_type": "playstation_vr2_sense",
  "compatibility_mode_controller_type": "oculus_touch",
  "device_class": "TrackedDeviceClass_Controller",
  "input_bindingui_mode": "controller_handed",
  "remapping": "{alvr_server}/input/playstation_vr2_sense_remapping.json",
  "input_source": {
    "/input/left_stick": { "type": "joystick", "side": "left", "click": true, "touch": true },
    "/input/right_stick": { "type": "joystick", "side": "right", "click": true, "touch": true },
    "/input/l1": { "type": "trigger", "side": "left", "click": true, "value": true, "touch": true },
    "/input/r1": { "type": "trigger", "side": "right", "click": true, "value": true, "touch": true },
    "/input/l2": { "type": "trigger", "side": "left", "click": true, "value": true, "touch": true },
    "/input/r2": { "type": "trigger", "side": "right", "click": true, "value": true, "touch": true },
    "/input/square": { "type": "button", "side": "left", "click": true, "touch": true },
    "/input/triangle": { "type": "button", "side": "left", "click": true, "touch": true },
    "/input/cross": { "type": "button", "side": "right", "click": true, "touch": true },
    "/input/circle": { "type": "button", "side": "right", "click": true, "touch": true },
    "/input/left_ps": { "type": "button", "side": "left", "click": true, "touch": true },
    "/input/right_ps": { "type": "button", "side": "right", "click": true, "touch": true },
    "/input/create": { "type": "button", "side": "left", "click": true, "touch": true },
    "/input/options": { "type": "button", "side": "right", "click": true, "touch": true },
    "/input/joystick": { "type": "joystick", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/thumbstick": { "type": "joystick", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/trigger": { "type": "trigger", "click": true, "value": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/grip": { "type": "trigger", "click": true, "value": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/system": { "type": "button", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/application_menu": { "type": "button", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/x": { "type": "button", "side": "left", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/y": { "type": "button", "side": "left", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/a": { "type": "button", "side": "right", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/b": { "type": "button", "side": "right", "click": true, "touch": true, "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/finger/index": { "type": "trigger", "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/finger/middle": { "type": "trigger", "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/finger/ring": { "type": "trigger", "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/finger/pinky": { "type": "trigger", "visibility": "InputValueVisibility_AvailableButHidden" },
    "/input/skeleton/left": { "type": "skeleton", "side": "left", "skeleton": "/skeleton/hand/left" },
    "/input/skeleton/right": { "type": "skeleton", "side": "right", "skeleton": "/skeleton/hand/right" },
    "/output/haptic": { "type": "vibration" },
    "/pose/raw": { "type": "pose" }
  }
}
